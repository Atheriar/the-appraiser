{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@shared/*": ["../src/core/*"] },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../src/core/api-types.ts", "../src/core/types.ts"]
}
